---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { getImage } from 'astro:assets';
import { site, tr, href, getPages, img } from '../lib/data.js';
import { ui } from '../lib/ui.js';

const { lang = 'en', title = '', description = '', path = '/', current = '', overImage = false, ogImage = '' } = Astro.props;
const t = ui[lang];
const other = lang === 'ar' ? 'en' : 'ar';
const brand = tr(site.brand, 'name', lang);
const pageTitle = title ? `${title} — ${brand}` : brand;
const desc = description || tr(site.brand, 'description', lang);
const menu = site.menu || {};
const extra = getPages().filter((p) => p.show_in_menu);
const origin = Astro.site?.toString().replace(/\/$/, '') ?? '';
const ogMeta = img(ogImage || site.home?.hero_image);
const og = ogMeta ? await getImage({ src: ogMeta, width: Math.min(1200, ogMeta.width), format: 'jpg', quality: 80 }) : null;
const c = site.contact || {};
---
<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#000000" />
  <title>{pageTitle}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={origin + href(lang, path)} />
  <link rel="alternate" hreflang="en" href={origin + href('en', path)} />
  <link rel="alternate" hreflang="ar" href={origin + href('ar', path)} />
  <link rel="alternate" hreflang="x-default" href={origin + href('en', path)} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={origin + href(lang, path)} />
  {og && <meta property="og:image" content={origin + og.src} />}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@300;400;500;600&family=IBM+Plex+Sans+Arabic:wght@300;400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip" href="#main">{t.skip}</a>
  <header class={overImage ? 'site' : 'site solid'} id="hdr" data-over={overImage ? '1' : '0'}>
    <div class="pad bar">
      <a href={href(lang, '/')} aria-label={brand}><Logo /></a>
      <nav class="main" id="nav" aria-label="Main">
        <a href={href(lang, '/projects/')} aria-current={current === 'projects' ? 'page' : undefined}>{tr(menu, 'projects', lang)}</a>
        <a href={href(lang, '/services/')} aria-current={current === 'services' ? 'page' : undefined}>{tr(menu, 'services', lang)}</a>
        <a href={href(lang, '/about/')} aria-current={current === 'about' ? 'page' : undefined}>{tr(menu, 'about', lang)}</a>
        {extra.map((p) => <a href={href(lang, `/${p.slug}/`)} aria-current={current === p.slug ? 'page' : undefined}>{tr(p, 'title', lang)}</a>)}
        <a href={href(lang, '/contact/')} aria-current={current === 'contact' ? 'page' : undefined}>{tr(menu, 'contact', lang)}</a>
        <a class="lang" href={href(other, path)} hreflang={other} lang={other}>{t.switch}</a>
      </nav>
      <button class="menu" id="menu" type="button" aria-expanded="false" aria-controls="nav" aria-label={t.menu}>
        <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true"><path d="M3 9h20M3 17h20" stroke="currentColor" stroke-width="1.4" /></svg>
      </button>
    </div>
  </header>

  <main id="main" tabindex="-1"><slot /></main>

  <footer class="site"><div class="pad">
    <div class="foot">
      <div><a href={href(lang, '/')} aria-label={brand}><Logo /></a></div>
      <nav aria-label="Footer">
        <a href={href(lang, '/projects/')}>{tr(menu, 'projects', lang)}</a>
        <a href={href(lang, '/services/')}>{tr(menu, 'services', lang)}</a>
        <a href={href(lang, '/about/')}>{tr(menu, 'about', lang)}</a>
        {extra.map((p) => <a href={href(lang, `/${p.slug}/`)}>{tr(p, 'title', lang)}</a>)}
        <a href={href(lang, '/contact/')}>{tr(menu, 'contact', lang)}</a>
      </nav>
      <div class="c">
        {c.email && <a class="ltr" href={`mailto:${c.email}`}>{c.email}</a>}
        {c.phone && <a class="ltr" href={`tel:${c.phone.replace(/\s/g, '')}`}>{c.phone}</a>}
        {c.whatsapp && <a href={`https://wa.me/${c.whatsapp.replace(/\D/g, '')}`} target="_blank" rel="noopener">{t.wa}</a>}
        {c.linkedin && <a href={c.linkedin} target="_blank" rel="noopener">{t.linkedin}</a>}
      </div>
    </div>
    <p class="legal">© {brand}</p>
  </div></footer>

  <script>
    const hdr = document.getElementById('hdr');
    const nav = document.getElementById('nav');
    const btn = document.getElementById('menu');
    const over = hdr?.dataset.over === '1';
    const update = () => hdr?.classList.toggle('solid', !over || scrollY > 40 || nav?.classList.contains('open'));
    btn?.addEventListener('click', () => {
      const open = nav?.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
      update();
    });
    addEventListener('scroll', update, { passive: true });
    update();
  </script>
</body>
</html>
